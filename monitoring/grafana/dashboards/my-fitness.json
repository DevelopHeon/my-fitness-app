        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "API 요청 수 · 선택 구간",
      "type": "stat",
      "description": "scrape 기반 추정 건수입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "my-fitness-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"my-fitness\",uri=~\"/api/.*\"}[$__range]))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "API 5xx 비율",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "my-fitness-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(http_server_requests_seconds_count{job=\"my-fitness\",uri=~\"/api/.*\",status=~\"5..\"}[10m])) or (sum(rate(http_server_requests_seconds_count{job=\"my-fitness\",uri=~\"/api/.*\"}[10m])) * 0)) / sum(rate(http_server_requests_seconds_count{job=\"my-fitness\",uri=~\"/api/.*\"}[10m]))) and (sum(rate(http_server_requests_seconds_count{job=\"my-fitness\",uri=~\"/api/.*\"}[10m])) > 0)",
          "legendFormat": "",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },

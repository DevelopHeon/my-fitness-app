        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,uri) (rate(http_server_requests_seconds_bucket{job=\"my-fitness\",uri=~\"/api/.*\"}[10m]))) and on(uri) (sum by(uri) (increase(http_server_requests_seconds_count{job=\"my-fitness\",uri=~\"/api/.*\"}[10m])) >= 20)",
          "legendFormat": "{{uri}}",
          "instant": false

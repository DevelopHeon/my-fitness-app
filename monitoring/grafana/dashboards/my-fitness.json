{
  "uid": "my-fitness-local",
  "title": "My Fitness · Local Observability",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "Asia/Seoul",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "my-fitness",
    "local"
  ],
  "panels": [
    {
      "id": 1,
      "title": "수집 상태",
      "type": "stat",
      "description": "0이면 앱·인증·네트워크를 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "my-fitness-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"my-fitness\"}",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "앱 가동 시간",
      "type": "stat",
      "description": "",

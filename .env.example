POSTGRES_DB=my_fitness
POSTGRES_USER=my_fitness
POSTGRES_PASSWORD=my_fitness
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/my_fitness
DB_USERNAME=my_fitness
DB_PASSWORD=my_fitness
SERVER_PORT=8080

# AI Coach
# 실제 AI 사용 시 openai 또는 ollama로 설정한다.
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=qwen3:1.7b
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=500
AI_REQUEST_TIMEOUT=30s
AI_PROMPT_VERSION=fitness-coach-v1
AI_HISTORY_MESSAGE_LIMIT=8
AI_HISTORY_CHAR_LIMIT=4000
AI_MAX_MESSAGE_LENGTH=1000
AI_TITLE_MAX_LENGTH=60

# Google OAuth2 / Session
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
LOGIN_SUCCESS_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30d
